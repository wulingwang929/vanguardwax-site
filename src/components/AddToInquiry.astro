---
import { localizePath, useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  sku: string;
  name: string;
  url: string;
  image?: string;
}
const { locale, sku, name, url, image } = Astro.props;
const t = useTranslations(locale);
---
<div class="add-to-inquiry" data-sku={sku} data-name={name} data-url={url} data-image={image}>
  <button type="button" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-red px-6 py-3 font-bold text-white hover:bg-brand-red/90 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-red/30 sm:w-auto">
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
    {t.inquiry.add}
  </button>
  <p role="status" class="mt-2 text-sm" data-status hidden>
    ✓ {t.inquiry.added} ·
    <a href={localizePath('/inquiry', locale)} class="font-bold underline">{t.inquiry.viewCart}</a>
  </p>
</div>
<script>
  import { addToCart } from '../scripts/inquiry-cart';
  document.querySelectorAll<HTMLElement>('.add-to-inquiry').forEach((root) => {
    const { sku = '', name = '', url = '', image } = root.dataset;
    root.querySelector('button')?.addEventListener('click', () => {
      addToCart({ sku, name, url, image });
      const status = root.querySelector<HTMLElement>('[data-status]');
      if (status) status.hidden = false;
    });
  });
</script>
