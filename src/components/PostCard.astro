---
import Img from './Img.astro';
import { formatDate } from '../lib/content';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  href: string;
  title: string;
  excerpt?: string;
  cover?: string;
  date?: Date;
  tag?: string;
}
const { locale, href, title, excerpt, cover, date, tag } = Astro.props;
---
<a href={href} class="group flex h-full flex-col overflow-hidden rounded-lg border border-brand-light bg-white transition hover:border-brand-black hover:shadow-md">
  <div class="aspect-[16/9] bg-brand-light">
    {cover && <Img src={cover} alt="" sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="size-full object-cover" />}
  </div>
  <div class="flex flex-1 flex-col p-4">
    <p class="flex gap-2 text-xs text-brand-body">
      {tag && <span class="font-bold">{tag}</span>}
      {date && <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, locale)}</time>}
    </p>
    <h3 class="mt-1 line-clamp-2 font-bold leading-snug group-hover:underline">{title}</h3>
    {excerpt && <p class="mt-2 line-clamp-3 text-sm text-brand-body">{excerpt}</p>}
  </div>
</a>
