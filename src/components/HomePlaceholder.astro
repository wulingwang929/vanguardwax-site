---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
---
<BaseLayout title={t.home.title} description={t.home.description}>
  <section class="bg-brand-charcoal text-white">
    <div class="mx-auto max-w-6xl px-4 py-20">
      <p class="text-sm font-bold tracking-widest text-white/70">{t.site.brandName}</p>
      <h1 class="mt-3 text-3xl font-bold md:text-5xl">{t.home.heading}</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/80">{t.home.lead}</p>
      <p class="mt-6 text-sm text-white/60">{t.site.companyName} · {t.home.since}</p>
    </div>
  </section>
</BaseLayout>
