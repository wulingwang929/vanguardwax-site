---
import { localizePath, useTranslations, type Locale } from '../i18n/utils';
import { sameAs } from '../data/organization';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const links = [
  ['/products', t.nav.products],
  ['/car-care', t.nav.carCare],
  ['/news', t.nav.news],
  ['/about', t.nav.about],
  ['/where-to-buy', t.nav.whereToBuy],
  ['/catalog', t.nav.catalog],
  ['/contact', t.nav.contact],
  ['/inquiry', t.nav.inquiry],
] as const;
const socialName = (url: string) =>
  ({ facebook: 'Facebook', instagram: 'Instagram', 'x.com': 'X', line: 'LINE', youtube: 'YouTube', alibaba: 'Alibaba' } as const)[
    (['facebook', 'instagram', 'x.com', 'line', 'youtube', 'alibaba'] as const).find((k) => url.includes(k)) ?? 'facebook'
  ];
---
<footer class="bg-brand-black text-white/80">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm md:grid-cols-3">
    <div class="space-y-2">
      <h2 class="font-bold text-white">{t.footer.contactHeading}</h2>
      <p class="font-bold text-white">{t.site.companyName}</p>
      <address class="space-y-1 not-italic">
        <p>{t.footer.address}</p>
        <p><a href={`tel:${t.footer.phone.replace(/[^\d+]/g, '')}`} class="hover:text-white">{t.footer.phone}</a></p>
        <p><a href={`mailto:${t.footer.email}`} class="hover:text-white">{t.footer.email}</a></p>
        <p class="text-white/60">{t.footer.hours}</p>
      </address>
    </div>
    <nav aria-label={t.footer.linksHeading}>
      <h2 class="font-bold text-white">{t.footer.linksHeading}</h2>
      <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1">
        {links.map(([path, label]) => <li><a href={localizePath(path, locale)} class="inline-block py-1 hover:text-white">{label}</a></li>)}
      </ul>
    </nav>
    <div>
      <h2 class="font-bold text-white">{t.footer.followHeading}</h2>
      <ul class="mt-2 flex flex-wrap gap-2">
        {sameAs.map((url) => <li><a href={url} rel="noopener" target="_blank" class="inline-block rounded border border-white/20 px-3 py-1 hover:border-white hover:text-white">{socialName(url)}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p class="inline-block self-start rounded bg-brand-red px-3 py-1 text-sm font-bold text-white">{t.footer.practiceNotice}</p>
      <p class="text-white/60">{t.footer.rights}</p>
    </div>
  </div>
</footer>
