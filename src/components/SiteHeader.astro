---
import { Image } from 'astro:assets';
import logo from '../assets/logo-on-dark-bg.png';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localizePath, stripLocale, useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const current = stripLocale(Astro.url.pathname).replace(/\/$/, '') || '/';
const links = [
  { path: '/products', label: t.nav.products },
  { path: '/car-care', label: t.nav.carCare },
  { path: '/news', label: t.nav.news },
  { path: '/about', label: t.nav.about },
  { path: '/contact', label: t.nav.contact },
];
const isActive = (path: string) => current === path || current.startsWith(`${path}/`);
const searchAction = localizePath('/search', locale);
---
<header class="sticky top-0 z-40 bg-brand-black text-white">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
    <a href={localizePath('/', locale)} class="shrink-0">
      <Image src={logo} alt={t.site.logoAlt} width={169} height={30} loading="eager" fetchpriority="high" class="h-7 w-auto md:h-8" />
    </a>

    <nav aria-label={t.nav.mainNav} class="ml-4 hidden lg:block">
      <ul class="flex gap-1 text-sm">
        {links.map((l) => (
          <li>
            <a
              href={localizePath(l.path, locale)}
              aria-current={isActive(l.path) ? 'page' : undefined}
              class="rounded px-3 py-2 hover:bg-white/10 aria-[current=page]:font-bold aria-[current=page]:text-white aria-[current=page]:underline aria-[current=page]:decoration-brand-red aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <form action={searchAction} method="get" role="search" class="hidden md:block">
        <label class="relative block">
          <span class="sr-only">{t.nav.search}</span>
          <input
            type="search"
            name="q"
            placeholder={t.search.placeholder}
            class="w-56 rounded-full border border-white/20 bg-white/10 py-1.5 pl-9 pr-3 text-sm text-white placeholder:text-white/50 focus:border-white focus:outline-none"
          />
          <svg class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-white/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        </label>
      </form>

      <a href={searchAction} class="rounded p-2 hover:bg-white/10 md:hidden" aria-label={t.nav.search}>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </a>

      <a href={localizePath('/inquiry', locale)} class="relative flex items-center gap-1.5 rounded p-2 text-sm hover:bg-white/10">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5h10l-1 9H8L6 3H3" /><circle cx="9" cy="19" r="1.5" /><circle cx="17" cy="19" r="1.5" /></svg>
        <span class="hidden sm:inline">{t.nav.inquiry}</span>
        <span data-inquiry-count hidden class="absolute -right-0.5 -top-0.5 grid min-w-5 place-items-center rounded-full bg-brand-red px-1 text-xs font-bold leading-5 sm:static">0</span>
      </a>

      <div class="hidden sm:block"><LanguageSwitcher locale={locale} /></div>

      <details class="group relative lg:hidden">
        <summary class="list-none rounded p-2 hover:bg-white/10 [&::-webkit-details-marker]:hidden" aria-label={t.nav.menu}>
          <svg class="size-6 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="hidden size-6 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </summary>
        <nav aria-label={t.nav.mainNav} class="absolute right-0 top-full mt-3 w-64 rounded-lg bg-brand-charcoal p-2 shadow-xl ring-1 ring-white/10">
          <ul class="text-base">
            {links.map((l) => (
              <li><a href={localizePath(l.path, locale)} aria-current={isActive(l.path) ? 'page' : undefined} class="block rounded px-3 py-3 hover:bg-white/10 aria-[current=page]:font-bold">{l.label}</a></li>
            ))}
            <li><a href={localizePath('/where-to-buy', locale)} class="block rounded px-3 py-3 hover:bg-white/10">{t.nav.whereToBuy}</a></li>
            <li><a href={localizePath('/catalog', locale)} class="block rounded px-3 py-3 hover:bg-white/10">{t.nav.catalog}</a></li>
          </ul>
          <div class="mt-2 border-t border-white/10 px-3 pb-2 pt-4 sm:hidden"><LanguageSwitcher locale={locale} /></div>
        </nav>
      </details>
    </div>
  </div>
</header>
