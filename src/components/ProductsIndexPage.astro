---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizePath, type Locale } from '../i18n/utils';
import { getLocalized, getSortedProducts, productPath } from '../lib/content';
import { SITE_URL } from '../data/organization';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const products = await getSortedProducts(locale);
const categories = (await getLocalized('categories', locale)).sort((a, b) => a.data.order - b.data.order);
const groups = categories
  .map((c) => ({ category: c, items: products.filter((p) => p.data.category === c.data.slug) }))
  .filter((g) => g.items.length > 0);

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.common.breadcrumbHome, item: new URL(localizePath('/', locale), SITE_URL).href },
    { '@type': 'ListItem', position: 2, name: t.products.heading, item: new URL(localizePath('/products', locale), SITE_URL).href },
  ],
};
---
<BaseLayout title={t.products.title} description={t.products.description} jsonLd={[breadcrumb]}>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl font-bold">{t.products.heading}</h1>
    {groups.length === 0 && <p class="mt-6 text-brand-body">{t.products.empty}</p>}
    {groups.map((g) => (
      <section class="mt-10">
        <h2 class="border-b border-brand-light pb-2 text-xl font-bold">{g.category.data.name}</h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((p) => (
            <li>
              <a href={productPath(p.data, locale)} class="block h-full rounded border border-brand-light p-4 hover:border-brand-black">
                {p.data.images?.[0] && <img src={p.data.images[0]} alt={p.data.name} loading="lazy" class="mb-3 aspect-square w-full object-contain" />}
                <p class="text-xs font-bold text-brand-body">{p.data.sku}{p.data.isNew && <span class="ml-2 rounded bg-brand-red px-1.5 text-white">{t.products.isNew}</span>}</p>
                <p class="mt-1 font-bold">{p.data.name}</p>
                <p class="mt-1 text-sm text-brand-body">{p.data.tagline}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
