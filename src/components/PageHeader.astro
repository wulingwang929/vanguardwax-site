---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Locale } from '../i18n/utils';
import type { Crumb } from '../lib/seo';

interface Props {
  locale: Locale;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
}
const { locale, title, lead, crumbs } = Astro.props;
---
<div class="border-b border-brand-light bg-brand-light/60">
  <div class="mx-auto max-w-6xl px-4 py-8 md:py-10">
    {crumbs && <Breadcrumbs locale={locale} items={crumbs} />}
    <h1 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">{title}</h1>
    {lead && <p class="mt-3 max-w-2xl text-brand-body md:text-lg">{lead}</p>}
    <slot />
  </div>
</div>
