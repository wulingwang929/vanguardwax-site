---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { locales, localizePath, useTranslations, defaultLocale, getLocaleFromUrl } from '../i18n/utils';
import { organizationJsonLd, SITE_URL } from '../data/organization';
import { GA4_ID, PRODUCTION_HOST } from '../data/site-config';

interface Props {
  title: string;
  description: string;
  /** 額外的 JSON-LD 節點，會併進 @graph */
  jsonLd?: Record<string, unknown>[];
  /** 放進 Pagefind 站內搜尋索引 */
  searchable?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
}
const { title, description, jsonLd = [], searchable = false, ogImage, ogType = 'website' } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const site = Astro.site ?? new URL(SITE_URL);
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(Astro.url.pathname);
const alternates = locales.map((l) => ({
  hreflang: useTranslations(l).lang.hreflang,
  href: abs(localizePath(Astro.url.pathname, l)),
}));
const xDefault = abs(localizePath(Astro.url.pathname, defaultLocale));

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationJsonLd(locale),
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: abs(localizePath('/', locale)),
      name: t.site.name,
      inLanguage: t.lang.hreflang,
      publisher: { '@id': `${SITE_URL}/#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${abs(localizePath('/search', locale))}?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    ...jsonLd,
  ],
};
---
<!doctype html>
<html lang={t.lang.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.lang.ogLocale} />
    <meta property="og:image" content={abs(ogImage ?? '/logo.png')} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(ogImage ?? '/logo.png')} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <!-- GA4：只在正式網址送資料，分支預覽網址與本機不送 -->
    <script is:inline define:vars={{ gaId: GA4_ID, host: PRODUCTION_HOST }}>
      if (location.hostname === host) {
        const s = document.createElement('script');
        s.async = true;
        s.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
        document.head.append(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', gaId);
      }
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-brand-black antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2">{t.nav.skipToContent}</a>
    <SiteHeader locale={locale} />
    <main id="main" class="flex-1" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <script>
      import { updateBadges } from '../scripts/inquiry-cart';
      updateBadges();
    </script>
  </body>
</html>
