---
import type { GetStaticPaths } from 'astro';
import ProductPage from '../../../../components/ProductPage.astro';
import { getSortedProducts, skuSlug } from '../../../../lib/content';

export const getStaticPaths = (async () => {
  const products = await getSortedProducts('en');
  return products.map((product) => ({
    params: { category: product.data.category, sku: skuSlug(product.data.sku) },
    props: { product },
  }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
---
<ProductPage locale="en" product={product} />
