---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Img from '../../../components/Img.astro';
import { locales, localizePath, useTranslations } from '../../../i18n/utils';
import { langParam } from '../../../lib/routes';
import { formatDate, getSortedArticles, getSortedProducts } from '../../../lib/content';
import { abs, breadcrumbJsonLd, crumbs, faqJsonLd, pageTitle } from '../../../lib/seo';
import { SITE_URL } from '../../../data/organization';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    const products = await getSortedProducts(locale);
    for (const article of await getSortedArticles(locale)) {
      const related = (article.data.relatedSkus ?? [])
        .map((s) => products.find((p) => p.data.sku.toLowerCase() === s.toLowerCase()))
        .filter((p) => p !== undefined);
      paths.push({ params: { lang: langParam(locale), slug: article.data.slug }, props: { locale, article, related } });
    }
  }
  return paths;
}
const { locale, article, related } = Astro.props;
const t = useTranslations(locale);
const a = article.data;
const { Content } = await render(article);
const path = `/car-care/${a.slug}`;
const bc = crumbs(locale, { name: t.carCare.heading, path: '/car-care' }, { name: a.title, path });
const jsonLd = [
  {
    '@type': 'Article',
    headline: a.title,
    description: a.excerpt,
    ...(a.cover && { image: abs(a.cover) }),
    datePublished: a.publishedAt.toISOString().slice(0, 10),
    dateModified: (a.updatedAt ?? a.publishedAt).toISOString().slice(0, 10),
    author: a.author
      ? { '@type': 'Person', name: a.author }
      : { '@type': 'Organization', '@id': `${SITE_URL}/#organization`, name: t.site.companyName, url: SITE_URL },
    publisher: { '@type': 'Organization', '@id': `${SITE_URL}/#organization`, name: t.site.companyName, url: SITE_URL },
    mainEntityOfPage: abs(localizePath(path, locale)),
    inLanguage: t.lang.hreflang,
    ...(a.tags?.length && { keywords: a.tags.join(', ') }),
  },
  breadcrumbJsonLd(locale, bc),
  ...faqJsonLd(a.faq),
];
---
<BaseLayout title={pageTitle(a.title, locale)} description={a.excerpt} jsonLd={jsonLd} searchable ogType="article" ogImage={a.cover}>
  <article class="mx-auto max-w-3xl px-4 py-8">
    {article.isFallback && <p class="mb-4 rounded bg-brand-light px-4 py-2 text-sm text-brand-body">{t.common.fallbackNotice}</p>}
    <Breadcrumbs locale={locale} items={bc} />
    <header class="mt-4">
      {a.tags?.length ? <p class="text-sm font-bold text-brand-red">{a.tags.join(' · ')}</p> : null}
      <h1 class="mt-2 text-3xl font-bold leading-tight tracking-tight md:text-4xl">{a.title}</h1>
      <p class="mt-3 text-sm text-brand-body">
        {t.common.publishedOn} <time datetime={a.publishedAt.toISOString().slice(0, 10)}>{formatDate(a.publishedAt, locale)}</time>
        {a.updatedAt && <> · {t.common.updatedOn} <time datetime={a.updatedAt.toISOString().slice(0, 10)}>{formatDate(a.updatedAt, locale)}</time></>}
      </p>
      <p class="mt-6 border-l-4 border-brand-red pl-4 text-lg leading-relaxed">{a.excerpt}</p>
    </header>
    {a.cover && !article.body?.includes(a.cover) && <Img src={a.cover} alt="" sizes="(min-width: 768px) 768px, 100vw" loading="eager" class="mt-8 w-full rounded-lg" />}
    <div class="prose-content mt-8 leading-relaxed"><Content /></div>
    {a.faq?.length ? (
      <section class="mt-10">
        <h2 class="text-xl font-bold">{t.products.faq}</h2>
        <div class="mt-3 divide-y divide-brand-light rounded-lg border border-brand-light">
          {a.faq.map((f) => <details class="p-4"><summary class="cursor-pointer font-bold">{f.q}</summary><p class="mt-2 text-brand-body">{f.a}</p></details>)}
        </div>
      </section>
    ) : null}
  </article>
  {related.length > 0 && (
    <section class="bg-brand-light/60" data-pagefind-ignore>
      <div class="mx-auto max-w-6xl px-4 py-10">
        <h2 class="text-xl font-bold">{t.carCare.relatedProducts}</h2>
        <ul class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-4">{related.map((p) => <li><ProductCard locale={locale} product={p} /></li>)}</ul>
      </div>
    </section>
  )}
</BaseLayout>
