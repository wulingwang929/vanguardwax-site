---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { localizePath, useTranslations, type Locale } from '../../i18n/utils';
import { localeStaticPaths } from '../../lib/routes';
import { breadcrumbJsonLd, crumbs, webPageJsonLd, pageTitle } from '../../lib/seo';
import { INQUIRY_ENDPOINT, INQUIRY_MIN_SECONDS } from '../../data/site-config';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const bc = crumbs(locale, { name: t.inquiry.heading, path: '/inquiry' });
const messages = {
  qty: t.inquiry.qty,
  remove: t.inquiry.remove,
  sending: t.inquiry.sending,
  submit: t.inquiry.submit,
  success: t.inquiry.success,
  errorGeneric: t.inquiry.errorGeneric,
  errorRateLimited: t.inquiry.errorRateLimited,
  errorTooFast: t.inquiry.errorTooFast,
  errorInvalid: t.inquiry.errorInvalid,
  errorEmpty: t.inquiry.errorEmpty,
  notConfigured: t.inquiry.notConfigured,
};
const field = 'mt-1 w-full rounded-lg border border-brand-body/30 px-3 py-2.5 text-base focus:border-brand-black focus:outline-none focus:ring-2 focus:ring-brand-black/10';
---
<BaseLayout title={pageTitle(t.inquiry.title, locale)} description={t.inquiry.description} jsonLd={[webPageJsonLd('WebPage', locale, { name: t.inquiry.heading, description: t.inquiry.description, path: '/inquiry' }), breadcrumbJsonLd(locale, bc)]}>
  <PageHeader locale={locale} title={t.inquiry.heading} lead={t.inquiry.lead} crumbs={bc} />
  <div
    id="inquiry"
    class="mx-auto grid max-w-6xl gap-8 px-4 py-10 lg:grid-cols-5"
    data-endpoint={INQUIRY_ENDPOINT}
    data-min-seconds={INQUIRY_MIN_SECONDS}
    data-lang={locale}
    data-messages={JSON.stringify(messages)}
  >
    <section class="min-w-0 lg:col-span-2">
      <h2 class="text-xl font-bold">{t.inquiry.itemsHeading}</h2>
      <ul data-items class="mt-4 divide-y divide-brand-light rounded-lg border border-brand-light empty:hidden"></ul>
      <div data-empty class="mt-4 rounded-lg bg-brand-light/70 p-5 text-sm text-brand-body" hidden>
        <p>{t.inquiry.empty}</p>
        <a href={localizePath('/products', locale)} class="mt-3 inline-block font-bold text-brand-black underline">{t.inquiry.browse} →</a>
      </div>
    </section>

    <section class="min-w-0 lg:col-span-3">
      <h2 class="text-xl font-bold">{t.inquiry.formHeading}</h2>
      <form data-form class="mt-4 grid gap-4 sm:grid-cols-2" novalidate>
        <label class="block text-sm font-bold">{t.inquiry.company}<input name="company" autocomplete="organization" maxlength="200" class={field} /></label>
        <label class="block text-sm font-bold">{t.inquiry.name} <span class="font-normal text-brand-red">*</span><input name="name" required autocomplete="name" maxlength="100" class={field} /></label>
        <label class="block text-sm font-bold">{t.inquiry.country} <span class="font-normal text-brand-red">*</span><input name="country" required autocomplete="country-name" maxlength="100" class={field} /></label>
        <label class="block text-sm font-bold">{t.inquiry.email} <span class="font-normal text-brand-red">*</span><input name="email" type="email" required autocomplete="email" maxlength="200" class={field} /></label>
        <label class="block text-sm font-bold sm:col-span-2">{t.inquiry.phone}<input name="phone" type="tel" autocomplete="tel" maxlength="50" class={field} /></label>
        <label class="block text-sm font-bold sm:col-span-2">{t.inquiry.message}<textarea name="message" rows="5" maxlength="3000" placeholder={t.inquiry.messagePlaceholder} class={field}></textarea></label>
        <!-- 防機器人：真人看不到這一欄 -->
        <div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden">
          <label>{t.inquiry.honeypot}<input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <p class="text-xs text-brand-body sm:col-span-2"><span class="text-brand-red">*</span> {t.inquiry.required} · {t.inquiry.practiceNote}</p>
        <div class="sm:col-span-2">
          <button type="submit" class="w-full rounded-lg bg-brand-red px-6 py-3 font-bold text-white hover:bg-brand-red/90 disabled:opacity-60 sm:w-auto">{t.inquiry.submit}</button>
          <p data-result role="status" aria-live="polite" class="mt-4 rounded-lg px-4 py-3 text-sm" hidden></p>
        </div>
      </form>
    </section>
  </div>
</BaseLayout>

<script>
  import { readCart, writeCart, type InquiryItem } from '../../scripts/inquiry-cart';
  import { thumbs } from '../../lib/images';

  const root = document.getElementById('inquiry');
  if (root) {
    const msg = JSON.parse(root.dataset.messages ?? '{}') as Record<string, string>;
    const endpoint = root.dataset.endpoint ?? '';
    const minSeconds = Number(root.dataset.minSeconds ?? 3);
    const startedAt = Date.now();
    const list = root.querySelector<HTMLUListElement>('[data-items]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    const render = () => {
      const items = readCart();
      empty.hidden = items.length > 0;
      list.replaceChildren(
        ...items.map((item) => {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-3 p-3';
          const img = document.createElement('img');
          img.src = item.image ? thumbs(item.image).src : '';
          img.alt = '';
          img.className = 'size-14 shrink-0 rounded border border-brand-light object-contain';
          if (!item.image) img.hidden = true;
          const info = document.createElement('div');
          info.className = 'min-w-0 flex-1';
          const link = document.createElement('a');
          link.href = item.url;
          link.className = 'block truncate font-bold hover:underline';
          link.textContent = item.name;
          const sku = document.createElement('p');
          sku.className = 'text-xs text-brand-body';
          sku.textContent = item.sku;
          info.append(link, sku);
          const qty = document.createElement('input');
          qty.type = 'number';
          qty.min = '1';
          qty.max = '99999';
          qty.value = String(item.qty);
          qty.className = 'w-20 rounded border border-brand-body/30 px-2 py-1.5 text-base';
          qty.setAttribute('aria-label', `${msg.qty} ${item.name}`);
          qty.addEventListener('change', () => {
            const n = Math.max(1, Math.min(99999, Math.floor(Number(qty.value)) || 1));
            qty.value = String(n);
            writeCart(readCart().map((i) => (i.sku === item.sku ? { ...i, qty: n } : i)));
          });
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'rounded px-2 py-1 text-sm text-brand-body underline hover:text-brand-red';
          remove.textContent = msg.remove;
          remove.addEventListener('click', () => {
            writeCart(readCart().filter((i) => i.sku !== item.sku));
            render();
          });
          li.append(img, info, qty, remove);
          return li;
        }),
      );
    };
    render();

    const show = (text: string, ok: boolean) => {
      result.textContent = text;
      result.className = `mt-4 rounded-lg px-4 py-3 text-sm ${ok ? 'bg-green-50 text-green-900' : 'bg-red-50 text-red-900'}`;
      result.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();
      const items: InquiryItem[] = readCart();
      if (!form.checkValidity()) {
        form.reportValidity();
        return show(msg.errorInvalid, false);
      }
      if (items.length === 0 && !get('message')) return show(msg.errorEmpty, false);
      if (!endpoint) return show(msg.notConfigured, false);
      if ((Date.now() - startedAt) / 1000 < minSeconds) return show(msg.errorTooFast, false);

      button.disabled = true;
      button.textContent = msg.sending;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          // text/plain 不會觸發 CORS 預檢，Apps Script 才收得到
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({
            lang: root.dataset.lang,
            company: get('company'),
            name: get('name'),
            country: get('country'),
            email: get('email'),
            phone: get('phone'),
            message: get('message'),
            website: get('website'),
            elapsedMs: Date.now() - startedAt,
            page: location.href,
            items: items.map(({ sku, name, qty }) => ({ sku, name, qty })),
          }),
        });
        const json = await res.json().catch(() => ({ ok: false }));
        if (json.ok) {
          writeCart([]);
          render();
          form.reset();
          show(msg.success, true);
        } else {
          const key = ({ rate_limited: 'errorRateLimited', too_fast: 'errorTooFast', invalid: 'errorInvalid' } as Record<string, string>)[json.error];
          show(msg[key ?? 'errorGeneric'], false);
        }
      } catch {
        show(msg.errorGeneric, false);
      } finally {
        button.disabled = false;
        button.textContent = msg.submit;
      }
    });
  }
</script>
