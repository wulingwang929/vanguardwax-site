---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Img from '../../../components/Img.astro';
import { locales, localizePath, useTranslations } from '../../../i18n/utils';
import { langParam } from '../../../lib/routes';
import { formatDate, getSortedNews } from '../../../lib/content';
import { abs, breadcrumbJsonLd, crumbs, plainText, pageTitle } from '../../../lib/seo';
import { SITE_URL } from '../../../data/organization';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    for (const item of await getSortedNews(locale)) {
      paths.push({ params: { lang: langParam(locale), slug: item.data.slug }, props: { locale, item } });
    }
  }
  return paths;
}
const { locale, item } = Astro.props;
const t = useTranslations(locale);
const n = item.data;
const { Content } = await render(item);
const path = `/news/${n.slug}`;
const description = plainText(item.body ?? '', 150) || n.title;
const bc = crumbs(locale, { name: t.news.heading, path: '/news' }, { name: n.title, path });
const jsonLd = [
  {
    '@type': 'NewsArticle',
    headline: n.title,
    description,
    ...(n.cover && { image: abs(n.cover) }),
    datePublished: n.date.toISOString().slice(0, 10),
    author: { '@id': `${SITE_URL}/#organization` },
    publisher: { '@id': `${SITE_URL}/#organization` },
    mainEntityOfPage: abs(localizePath(path, locale)),
    inLanguage: t.lang.hreflang,
  },
  breadcrumbJsonLd(locale, bc),
];
---
<BaseLayout title={pageTitle(n.title, locale)} description={description} jsonLd={jsonLd} searchable ogType="article" ogImage={n.cover}>
  <article class="mx-auto max-w-3xl px-4 py-8">
    {item.isFallback && <p class="mb-4 rounded bg-brand-light px-4 py-2 text-sm text-brand-body">{t.common.fallbackNotice}</p>}
    <Breadcrumbs locale={locale} items={bc} />
    <h1 class="mt-4 text-3xl font-bold leading-tight tracking-tight md:text-4xl">{n.title}</h1>
    <p class="mt-3 text-sm text-brand-body"><time datetime={n.date.toISOString().slice(0, 10)}>{formatDate(n.date, locale)}</time></p>
    {n.cover && !item.body?.includes(n.cover) && <Img src={n.cover} alt="" sizes="(min-width: 768px) 768px, 100vw" loading="eager" class="mt-8 w-full rounded-lg" />}
    <div class="prose-content mt-8 leading-relaxed"><Content /></div>
  </article>
</BaseLayout>
