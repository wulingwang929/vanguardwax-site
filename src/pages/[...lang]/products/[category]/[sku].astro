---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Img from '../../../../components/Img.astro';
import Markdown from '../../../../components/Markdown.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import AddToInquiry from '../../../../components/AddToInquiry.astro';
import YouTube from '../../../../components/YouTube.astro';
import { locales, useTranslations } from '../../../../i18n/utils';
import { langParam } from '../../../../lib/routes';
import { getSortedCategories, getSortedProducts, productPath, relatedProducts, skuSlug } from '../../../../lib/content';
import { youtubeId } from '../../../../lib/images';
import { abs, breadcrumbJsonLd, crumbs, faqJsonLd, plainText } from '../../../../lib/seo';
import { SITE_URL } from '../../../../data/organization';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    const products = await getSortedProducts(locale);
    const categories = await getSortedCategories(locale);
    for (const product of products) {
      paths.push({
        params: { lang: langParam(locale), category: product.data.category, sku: skuSlug(product.data.sku) },
        props: {
          locale,
          product,
          category: categories.find((c) => c.data.slug === product.data.category),
          related: relatedProducts(product, products),
        },
      });
    }
  }
  return paths;
}
const { locale, product, category, related } = Astro.props;
const t = useTranslations(locale);
const p = product.data;
const url = productPath(p, locale);
const images = p.images ?? [];
const specRows = (
  [
    ['capacity', p.specs?.capacity],
    ['origin', p.specs?.origin],
    ['boxQty', p.specs?.boxQty],
    ['dimensions', p.specs?.dimensions],
    ['ingredients', p.specs?.ingredients],
  ] as const
).filter(([, v]) => v !== undefined && v !== '');
const otherSpecs = (p.specs?.other ?? []).map((line) => {
  const m = line.match(/^([^：:]{1,20})[：:]\s*(.+)$/);
  return m ? { label: m[1], value: m[2] } : { label: '', value: line };
});
// 型號不帶連字號的寫法，讓站內搜尋「RH5070」也找得到「RH-5070」
const skuAliases = [...new Set([p.sku.replace(/-/g, ''), p.sku.replace(/-/g, ' ')])].filter((s) => s !== p.sku);

const title = `${p.name} ${p.sku}${t.common.titleSep}${t.site.titleSuffix}`;
const description = `${p.tagline}${p.description ? ` ${plainText(p.description, 110)}` : ''}`.slice(0, 160);
const bc = crumbs(
  locale,
  { name: t.products.heading, path: '/products' },
  ...(category ? [{ name: category.data.name, path: `/products/${category.data.slug}` }] : []),
  { name: p.name, path: `/products/${p.category}/${skuSlug(p.sku)}` },
);
const vid = youtubeId(p.youtubeUrl);
const jsonLd: Record<string, unknown>[] = [
  {
    '@type': 'Product',
    '@id': `${abs(url)}#product`,
    name: p.name,
    sku: p.sku,
    mpn: p.sku,
    ...(p.barcode && { gtin13: p.barcode }),
    brand: { '@type': 'Brand', name: p.brand },
    description: p.tagline,
    ...(images.length && { image: images.map(abs) }),
    ...(category && { category: category.data.name }),
    url: abs(url),
    manufacturer: { '@id': `${SITE_URL}/#organization` },
    ...(specRows.length && {
      additionalProperty: specRows.map(([k, v]) => ({ '@type': 'PropertyValue', name: t.products[k], value: String(v) })),
    }),
  },
  breadcrumbJsonLd(locale, bc),
  ...faqJsonLd(p.faq),
];
if (vid) {
  jsonLd.push({
    '@type': 'VideoObject',
    name: p.name,
    description: p.tagline,
    thumbnailUrl: `https://i.ytimg.com/vi/${vid}/hqdefault.jpg`,
    embedUrl: `https://www.youtube.com/embed/${vid}`,
    contentUrl: `https://www.youtube.com/watch?v=${vid}`,
  });
}
---
<BaseLayout title={title} description={description} jsonLd={jsonLd} searchable ogType="product" ogImage={images[0]}>
  <article>
    <div class="mx-auto max-w-6xl px-4 pt-6">
      {product.isFallback && <p class="mb-4 rounded bg-brand-light px-4 py-2 text-sm text-brand-body">{t.common.fallbackNotice}</p>}
      <Breadcrumbs locale={locale} items={bc} />
    </div>

    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-6 md:grid-cols-2 md:gap-12">
      <!-- 圖片：手機左右滑，桌機大圖＋縮圖 -->
      <div data-pagefind-ignore>
        {images.length > 0 && (
          <>
            <ul class="flex snap-x snap-mandatory gap-3 overflow-x-auto rounded-lg md:grid md:grid-cols-1 md:overflow-visible" aria-label={t.products.imageOf}>
              {images.map((src, i) => (
                <li id={`img-${i + 1}`} class:list={['aspect-square w-[85%] shrink-0 snap-center rounded-lg border border-brand-light bg-white p-4 md:w-full', i > 0 && 'md:hidden']}>
                  <Img src={src} alt={`${p.name} ${t.products.imageOf} ${i + 1}`} sizes="(min-width: 768px) 50vw, 85vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} class="size-full object-contain" />
                </li>
              ))}
            </ul>
            {images.length > 1 && (
              <ul class="mt-3 hidden grid-cols-5 gap-2 md:grid" data-gallery-thumbs>
                {images.map((src, i) => (
                  <li>
                    <button type="button" data-index={i} class="aspect-square w-full rounded border border-brand-light bg-white p-1 hover:border-brand-black aria-[current=true]:border-brand-black" aria-current={i === 0 ? 'true' : 'false'} aria-label={`${t.products.imageOf} ${i + 1}`}>
                      <Img src={src} alt="" sizes="80px" class="size-full object-contain" />
                    </button>
                  </li>
                ))}
              </ul>
            )}
          </>
        )}
      </div>

      <!-- 基本資料＋加入詢價 -->
      <div>
        <p class="text-sm font-bold tracking-wide text-brand-body">{t.products.sku} {p.sku}{p.isNew && <span class="ml-2 rounded bg-brand-red px-2 py-0.5 text-xs text-white">{t.products.isNew}</span>}</p>
        <h1 class="mt-2 text-2xl font-bold leading-tight tracking-tight md:text-4xl">{p.name}</h1>
        <p class="mt-4 text-lg text-brand-body">{p.tagline}</p>
        {skuAliases.length > 0 && <p hidden>{skuAliases.join(' ')}</p>}

        {specRows.length > 0 && (
          <dl class="mt-6 grid grid-cols-2 gap-3 text-sm">
            {specRows.slice(0, 4).map(([k, v]) => (
              <div class="rounded-lg bg-brand-light/70 px-3 py-2"><dt class="text-xs text-brand-body">{t.products[k]}</dt><dd class="mt-0.5 font-bold">{v}</dd></div>
            ))}
          </dl>
        )}

        <div class="mt-6" data-pagefind-ignore>
          <AddToInquiry locale={locale} sku={p.sku} name={p.name} url={url} image={images[0]} />
        </div>
        <p class="mt-3 text-xs text-brand-body">{t.products.brand} {p.brand}{category && <> · <a href={`${url.replace(/\/[^/]+$/, '')}`} class="underline">{category.data.name}</a></>}</p>
      </div>
    </div>

    <div class="mx-auto grid max-w-6xl gap-10 px-4 pb-12 lg:grid-cols-3">
      <div class="space-y-10 lg:col-span-2">
        {p.description && (
          <section><h2 class="text-xl font-bold">{t.products.descriptionHeading}</h2><Markdown text={p.description} class="mt-3 leading-relaxed" /></section>
        )}
        {p.features?.length ? (
          <section><h2 class="text-xl font-bold">{t.products.features}</h2><ul class="mt-3 list-disc space-y-1 pl-6">{p.features.map((f) => <li>{f}</li>)}</ul></section>
        ) : null}
        {p.usageSteps?.length ? (
          <section>
            <h2 class="text-xl font-bold">{t.products.usage}</h2>
            <ol class="mt-3 space-y-3">
              {p.usageSteps.map((s, i) => (
                <li class="flex gap-3"><span class="grid size-7 shrink-0 place-items-center rounded-full bg-brand-black text-sm font-bold text-white">{i + 1}</span><span class="pt-0.5">{s}</span></li>
              ))}
            </ol>
          </section>
        ) : null}
        {vid && p.youtubeUrl && (
          <section data-pagefind-ignore><h2 class="text-xl font-bold">{t.products.video}</h2><div class="mt-3"><YouTube url={p.youtubeUrl} title={p.name} playLabel={t.products.playVideo} /></div></section>
        )}
        {p.faq?.length ? (
          <section>
            <h2 class="text-xl font-bold">{t.products.faq}</h2>
            <div class="mt-3 divide-y divide-brand-light rounded-lg border border-brand-light">
              {p.faq.map((f) => (
                <details class="group p-4"><summary class="cursor-pointer list-none font-bold">{f.q}</summary><p class="mt-2 text-brand-body">{f.a}</p></details>
              ))}
            </div>
          </section>
        ) : null}
      </div>

      <aside class="space-y-8">
        {(specRows.length > 0 || p.barcode || otherSpecs.length > 0) && (
          <section>
            <h2 class="text-xl font-bold">{t.products.specs}</h2>
            <table class="mt-3 w-full text-sm">
              <tbody class="divide-y divide-brand-light">
                <tr><th scope="row" class="w-28 py-2 pr-3 text-left align-top font-normal text-brand-body">{t.products.sku}</th><td class="py-2">{p.sku}</td></tr>
                {specRows.map(([k, v]) => <tr><th scope="row" class="py-2 pr-3 text-left align-top font-normal text-brand-body">{t.products[k]}</th><td class="py-2">{v}</td></tr>)}
                {p.barcode && <tr><th scope="row" class="py-2 pr-3 text-left align-top font-normal text-brand-body">{t.products.barcode}</th><td class="py-2">{p.barcode}</td></tr>}
                {otherSpecs.map((s) => <tr><th scope="row" class="py-2 pr-3 text-left align-top font-normal text-brand-body">{s.label}</th><td class="py-2">{s.value}</td></tr>)}
              </tbody>
            </table>
          </section>
        )}
        {p.safety && (
          <section class="rounded-lg border-l-4 border-brand-red bg-brand-light/70 p-4">
            <h2 class="font-bold">{t.products.safety}</h2>
            <Markdown text={p.safety} class="mt-2 text-sm" />
          </section>
        )}
      </aside>
    </div>

    {related.length > 0 && (
      <section class="bg-brand-light/60" data-pagefind-ignore>
        <div class="mx-auto max-w-6xl px-4 py-10">
          <h2 class="text-xl font-bold md:text-2xl">{t.products.related}</h2>
          <ul class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-4">
            {related.map((r) => <li><ProductCard locale={locale} product={r} /></li>)}
          </ul>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  // 桌機版：點縮圖換大圖
  document.querySelectorAll<HTMLElement>('[data-gallery-thumbs]').forEach((thumbs) => {
    const slides = thumbs.previousElementSibling?.querySelectorAll<HTMLElement>(':scope > li') ?? [];
    thumbs.querySelectorAll<HTMLButtonElement>('button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = Number(btn.dataset.index);
        slides.forEach((s, i) => s.classList.toggle('md:hidden', i !== index));
        thumbs.querySelectorAll('button').forEach((b) => b.setAttribute('aria-current', String(b === btn)));
      });
    });
  });
</script>
